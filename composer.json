{
    "name": "itcrackers/helper",
    "description": "Common package for Core PHP and It's Related Frameworks",
    "type": "library",
    "authors": [
        {
            "name": "IT Crackers",
            "email": "itcrackers04@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ITCrackers\\Helper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ITCrackers\\Helper\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}